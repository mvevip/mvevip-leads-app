# ==============================================================================
# CONFIGURACIÓN DE ENTORNO DE EJEMPLO - MVEVIP LEAD REMINDER PWA
# Copia este archivo a .env y completa con tus valores reales
# ==============================================================================

# Rango de Puertos Asignado (6410 - 6420)
PORT_FRONTEND=6410
PORT_BACKEND=6411
PORT_DB=6412

# Zona Horaria (Ecuador - Quito / Guayaquil UTC-5)
TZ=America/Guayaquil

# Node Environment
NODE_ENV=development

# URLs Base
CLIENT_URL=http://localhost:6410
API_URL=http://localhost:6411

# ==============================================================================
# BASE DE DATOS (MySQL)
# ==============================================================================
DB_HOST=db
DB_PORT=3306
DB_USER=tu_usuario_db
DB_PASSWORD=tu_password_segura
DB_NAME=mvevip_lead_db
DATABASE_URL="mysql://tu_usuario_db:tu_password_segura@db:3306/mvevip_lead_db"

# Para conexión directa fuera de Docker (ej. Prisma Studio local o migraciones host)
LOCAL_DATABASE_URL="mysql://tu_usuario_db:tu_password_segura@localhost:6412/mvevip_lead_db"

# ==============================================================================
# SEGURIDAD & AUTENTICACIÓN (JWT - 5 días de validez)
# ==============================================================================
JWT_SECRET=tu_jwt_secret_largo_y_aleatorio_aqui
JWT_EXPIRES_IN=5d

# ==============================================================================
# WEB PUSH NOTIFICATIONS (VAPID Gratuito)
# Generar con: npx web-push generate-vapid-keys
# ==============================================================================
VAPID_PUBLIC_KEY=tu_vapid_public_key
VAPID_PRIVATE_KEY=tu_vapid_private_key
VAPID_SUBJECT=mailto:soporte@tudominio.com

# ==============================================================================
# INTELIGENCIA ARTIFICIAL GEMINI API (Multimodal / Function Calling)
# Obtener en: https://aistudio.google.com/
# ==============================================================================
GEMINI_API_KEY=tu_gemini_api_key

# ==============================================================================
# ARCHIVOS SUBIDOS (S3) - solo producción en AWS Lambda
# Las fotos de clientes y avatares se guardan en s3://<bucket>/uploads/ (privado) y se
# entregan con URLs firmadas. MEDIA_SIGNER_* son las claves de un usuario IAM de solo
# lectura sobre uploads/*; sin ellas se firma con el rol de la Lambda y las URLs duran menos.
# ==============================================================================
S3_BUCKET_NAME=
CLOUDFRONT_DOMAIN=
MEDIA_SIGNER_ACCESS_KEY_ID=
MEDIA_SIGNER_SECRET_ACCESS_KEY=

# ==============================================================================
# SEGURIDAD DE LA API (opcionales)
# ==============================================================================
# Orígenes permitidos por CORS, separados por comas (por defecto: https://leads.mvevip.com,http://localhost:6410)
CORS_ORIGINS=
# Habilita GET /api/cron/check-reminders (se envía en el header x-cron-secret). Sin valor la ruta responde 404.
# En producción el cron lo invoca EventBridge directamente sobre la Lambda y no usa esta ruta.
CRON_SECRET=

